<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- AAOS 표준 차량 API: 차속(CAR_SPEED, 실행 중 허용 필요), 기어(CAR_POWERTRAIN) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Pleos Vehicle SDK: 기어(CAR_DRIVE), 방향지시등(CAR_LIGHTS), 누적 주행 거리(CAR_INFO) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <!-- Pleos NaviHelper: 경로 시작·도착 (실차 단계의 예상 주행 시간 보조) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 주행 중 백그라운드 클래스 (소리만, 조용한 상태 알림) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TTS 엔진 확인 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".SedaeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SedaeCha">

        <!-- distractionOptimized 를 선언하지 않는다: 주행 중에는 플랫폼(CarUxRestrictions)이 앱 화면을 가리고,
             주차하면 다시 보인다. 주행 중 클래스는 화면 없이 소리로만 진행한다. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 주행 클래스 서비스 -->
        <service
            android:name=".service.ClassService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="in_vehicle_audio_class_driven_by_vehicle_data" />
        </service>

    </application>

</manifest>
